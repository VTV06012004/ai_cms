MYSQL_DATABASE=ai_cms_db
MYSQL_USER=cms_user
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
JWT_SECRET=replace-with-a-random-jwt-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Local HTTP only; set true in production when serving the API over HTTPS.
AUTH_COOKIE_SECURE=false
API_PORT=8081
# Public origin of the API, used to build image URLs (use your https domain in production).
PUBLIC_BASE_URL=http://localhost:8081
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# For running the API directly outside Docker Compose:
DB_DSN=cms_user:replace-with-a-random-database-password@tcp(127.0.0.1:3306)/ai_cms_db?parseTime=true&loc=Local

# First admin account (only used when the database has no admin yet):
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password